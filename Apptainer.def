# Apptainer definition file for AlpaSim. Builds the same environment as the
# Dockerfile without needing a Docker daemon.
#
# Build with the wrapper, which stages a slim context and sets up scratch dirs:
#   ./build_apptainer.sh
#
# Or directly (the bind makes ~/.netrc available for private dependencies; it is
# not stored in the image):
#   apptainer build --fakeroot --bind $HOME/.netrc:/run/netrc:ro \
#     alpasim_base_<version>.sif Apptainer.def
#
# Keep the base image and apt packages in sync with the Dockerfile; the test
# `test_apptainer_definition_matches_dockerfile` enforces this. Two Dockerfile
# features have no def-file equivalent and are intentionally absent: multi-arch
# selection (this builds x86_64; on aarch64 convert a Docker image instead with
# `build_apptainer.sh --from-registry`), and the dcgm-exporter binary copied
# from the NVIDIA image, without which the telemetry sidecar simply reports no
# GPU metrics.

Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

%files
    . /repo

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        git \
        ffmpeg \
        curl \
        build-essential \
        libgl1 \
        prometheus \
        prometheus-node-exporter \
        prometheus-process-exporter \
        && rm -rf /var/lib/apt/lists/*

    # uv (the Dockerfile copies it from ghcr.io/astral-sh/uv)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Rust toolchain, required to build the utils_rs maturin extension
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    export PATH="/root/.cargo/bin:$PATH"

    # Credentials for private dependencies, bind-mounted read-only by the caller.
    # Copied in for the sync steps and deleted again below, so they are never
    # part of the image.
    if [ -f /run/netrc ]; then
        cp /run/netrc /root/.netrc
        chmod 600 /root/.netrc
        export NETRC=/root/.netrc
    fi

    # %files copies the build context verbatim, so drop any host virtualenvs
    # that came along: their absolute paths and binaries are not valid here.
    find /repo -name ".venv" -type d -prune -exec rm -rf {} + 2>/dev/null || true

    export UV_LINK_MODE=copy

    # Compile protos
    cd /repo/src/grpc
    uv sync
    uv run compile-protos --no-sync

    cd /repo
    uv sync --extra all

    # PyG compiled extensions, from wheels matching the installed torch + CUDA.
    # Versions mirror the Dockerfile's build args.
    PYTORCH_VERSION=2.8.0+cu128
    uv pip install \
        "torch-cluster==1.6.3" \
        "torch-scatter==2.1.2" \
        "torch-sparse==0.6.18" \
        -f "https://data.pyg.org/whl/torch-${PYTORCH_VERSION}.html"

    rm -f /root/.netrc

%environment
    export PATH="/root/.local/bin:/root/.cargo/bin:$PATH"
    export UV_CACHE_DIR=/tmp/uv-cache
    export UV_NO_SYNC=1
    export UV_LINK_MODE=copy
    export UV_PROJECT_ENVIRONMENT=/repo/.venv

%runscript
    exec uv run python "$@"

%labels
    Author NVIDIA AlpaSim Team
    Description AlpaSim simulation container (Apptainer)

%help
    AlpaSim simulation container for Apptainer. Supports GPU passthrough via --nv.

    The wizard drives this image for you:
        uv run alpasim_wizard deploy=local_apptainer topology=1gpu driver=vavam \
            wizard.log_dir=$PWD/out

    To run a service by hand, note that Apptainer ignores the image's WORKDIR,
    so pass --pwd explicitly:
        apptainer exec --nv --pwd /repo --bind ./data:/mnt/data \
            alpasim_base_<version>.sif bash -c "uv run python -m alpasim_controller.server"
